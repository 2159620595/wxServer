# wxServer 环境变量（仅放 Vercel，勿提交真实值）

# 必填：API 鉴权密钥，URL 路径需一致
SENDKEY=SCTyour_secret_key

# 可选：控制台测试推送 / 查询 openid
CONSOLE_TOKEN=your_console_password

# 微信公众号（推个人微信，见 docs/WECHAT_MP.md）
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_OPENID=
WECHAT_MP_TEMPLATE_ID=
# WECHAT_MP_FIELD_TITLE=first
# WECHAT_MP_FIELD_BODY=keyword1
# WECHAT_MP_FIELD_REMARK=remark

# 其它通道（可选，可多个同时启用）
WECHAT_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BARK_URL=
